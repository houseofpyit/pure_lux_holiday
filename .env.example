# Copy to .env before `docker compose up`. Never commit real keys.

APP_NAME=Pure Luxe Holidays
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-docker-at-least-32-characters

POSTGRES_USER=plh
POSTGRES_PASSWORD=plh
POSTGRES_DB=pure_luxe_holidays
POSTGRES_PORT=5432
REDIS_PORT=6379

BACKEND_PORT=8000
ADMIN_PORT=5174
WEB_PORT=5173

SEED_ADMIN_EMAIL=admin@plh.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Super Admin
RUN_SEED=true
# Clear seed/ images from R2/local before each seed run (testing). Set false in production.
SEED_CLEAR_STORAGE=true
# Wipe entire bucket before seed — development only. Use when testing fills R2.
SEED_CLEAR_ALL_STORAGE=false
UVICORN_WORKERS=2

VITE_API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]

# ── Cloudflare R2 ───────────────────────────────────────────────────────────
STORAGE_BACKEND=r2

# Account ID = subdomain of the endpoint URL
# e.g. https://7d149339....r2.cloudflarestorage.com → 7d149339....
R2_ACCOUNT_ID=

# From "Manage R2 API Tokens" → Access Key ID
R2_ACCESS_KEY_ID=

# From "Manage R2 API Tokens" → Secret Access Key
R2_SECRET_ACCESS_KEY=

# Bucket name (last part of bucket URL)
R2_BUCKET_NAME=pure-luxe-holidays

# S3 API endpoint (private — backend uploads only)
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Public URL for browsers — R2 bucket → Settings → Public access → r2.dev URL
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# cfat_ token is NOT used by this app — Cloudflare dashboard API only
